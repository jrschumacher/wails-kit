<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="stylesheet" href="/src/style.css" />
  <title>{{.ProductName}}</title>
</head>
<body>
  <div id="app">
    <header class="topbar">
      <h1>{{.ProductName}}</h1>
      <span id="health-badge" class="health-badge" data-state="unknown" title="Checking backend health…"></span>
    </header>

    <div id="update-toast" class="toast" hidden>
      <span id="update-toast-message"></span>
      <button id="update-toast-dismiss" type="button" aria-label="Dismiss">×</button>
    </div>

    <main>
      <form id="settings-form">
        <div id="settings-groups"></div>
        <div class="form-actions">
          <button type="submit">Save</button>
          <span id="save-status" role="status"></span>
        </div>
      </form>
    </main>
  </div>
  <script type="module" src="/src/main.ts"></script>
</body>
</html>
